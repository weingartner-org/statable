FREQUENCIES VARIABLES=gruppe
  /STATISTICS=MEAN MEDIAN
  /ORDER=ANALYSIS.
DESCRIPTIVES VARIABLES=prae post
  /STATISTICS=MEAN STDDEV MIN MAX.
EXAMINE VARIABLES=post BY gruppe
  /PLOT BOXPLOT STEMLEAF NPPLOT
  /COMPARE GROUPS
  /STATISTICS DESCRIPTIVES
  /CINTERVAL 95
  /MISSING LISTWISE
  /NOTOTAL.
CROSSTABS
  /TABLES=gruppe BY bestanden
  /FORMAT=AVALUE TABLES
  /STATISTICS=CHISQ PHI
  /CELLS=COUNT EXPECTED ROW
  /COUNT ROUND CELL.
T-TEST GROUPS=geschlecht(1 2)
  /MISSING=ANALYSIS
  /VARIABLES=post
  /ES DISPLAY(TRUE)
  /CRITERIA=CI(.95).
T-TEST PAIRS=prae WITH post (PAIRED)
  /ES DISPLAY(TRUE) STANDARDIZER(SD)
  /CRITERIA=CI(.9500)
  /MISSING=ANALYSIS.
T-TEST
  /TESTVAL=50
  /MISSING=ANALYSIS
  /VARIABLES=prae
  /ES DISPLAY(TRUE)
  /CRITERIA=CI(.95).
ONEWAY post BY gruppe
  /ES=OVERALL
  /STATISTICS DESCRIPTIVES HOMOGENEITY WELCH
  /MISSING ANALYSIS
  /CRITERIA=CILEVEL(0.95)
  /POSTHOC=TUKEY GH ALPHA(0.05).
CORRELATIONS
  /VARIABLES=prae post lernzeit
  /PRINT=TWOTAIL NOSIG FULL
  /MISSING=PAIRWISE.
NONPAR CORR
  /VARIABLES=prae post
  /PRINT=SPEARMAN TWOTAIL NOSIG FULL
  /MISSING=PAIRWISE.
REGRESSION
  /MISSING LISTWISE
  /STATISTICS COEFF OUTS R ANOVA
  /CRITERIA=PIN(.05) POUT(.10)
  /NOORIGIN
  /DEPENDENT post
  /METHOD=ENTER prae lernzeit.
LOGISTIC REGRESSION VARIABLES bestanden
  /METHOD=ENTER prae geschlecht
  /CATEGORICAL=geschlecht
  /CONTRAST (geschlecht)=Indicator
  /CRITERIA=PIN(.05) POUT(.10) ITERATE(20) CUT(.5).
RELIABILITY
  /VARIABLES=a1 a2 a3 a4
  /SCALE('ALL VARIABLES') ALL
  /MODEL=ALPHA
  /STATISTICS=DESCRIPTIVE SCALE
  /SUMMARY=TOTAL.
FACTOR
  /VARIABLES m1 m2 m3 m5 m6
  /MISSING LISTWISE
  /ANALYSIS m1 m2 m3 m5 m6
  /PRINT INITIAL KMO EXTRACTION ROTATION
  /CRITERIA MINEIGEN(1) ITERATE(25)
  /EXTRACTION PC
  /CRITERIA ITERATE(25)
  /ROTATION VARIMAX
  /METHOD=CORRELATION.
NPAR TESTS
  /M-W= post BY geschlecht(1 2)
  /MISSING ANALYSIS.
NPAR TESTS
  /WILCOXON=prae WITH post (PAIRED)
  /MISSING ANALYSIS.
NPAR TESTS
  /K-W=post BY gruppe(1 3)
  /MISSING ANALYSIS.
UNIANOVA post BY gruppe geschlecht
  /METHOD=SSTYPE(3)
  /INTERCEPT=INCLUDE
  /PRINT ETASQ DESCRIPTIVE
  /CRITERIA=ALPHA(.05)
  /DESIGN=gruppe geschlecht gruppe*geschlecht.
GLM m1 m2 m3
  /WSFACTOR=zeit 3 Polynomial
  /METHOD=SSTYPE(3)
  /PRINT=ETASQ
  /CRITERIA=ALPHA(.05)
  /WSDESIGN=zeit.
COMPUTE motiv=MEAN(m1,m2,m3).
EXECUTE.
RECODE m4 (1=5) (2=4) (3=3) (4=2) (5=1) INTO m4r.
EXECUTE.
