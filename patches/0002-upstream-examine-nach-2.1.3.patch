From 80ddaf8fefc37f2604a62451cfdc68fa7e1e6dc6 Mon Sep 17 00:00:00 2001
From: John Darrington <john@cellform.com>
Date: Sun, 25 Oct 2026 08:28:33 +0100
Subject: [PATCH 2/2] Fix interpretation of EXAMINE /CINTERVAL

The CINTERVAL subcommand of EXAMINE is supposed to take
a percentage, but was being interpreted as a fraction.
This change fixes that.

Thanks to Johannes Weingartner for reporting this.
---
 src/language/commands/examine.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/language/commands/examine.c b/src/language/commands/examine.c
index b3039d7..02bd772 100644
--- a/src/language/commands/examine.c
+++ b/src/language/commands/examine.c
@@ -1687,7 +1687,13 @@ cmd_examine (struct lexer *lexer, struct dataset *ds)
           if (!lex_force_num (lexer))
             goto error;
 
-          examine.conf = lex_number (lexer);
+          examine.conf = 0.01 * lex_number (lexer);
+          if (examine.conf > 1.0 || examine.conf < 0.0)
+            {
+              lex_error (lexer,
+                         _("CINTERVAL must be lie between 0 and 100, inclusive."));
+              goto error;
+            }
           lex_get (lexer);
         }
       else if (lex_match_id (lexer, "ID"))
-- 
