From 346d7c0d8d4187e1203f04f9a514cfd6562cebeb Mon Sep 17 00:00:00 2001
From: John Darrington <john@cellform.com>
Date: Sat, 24 Oct 2026 23:18:34 +0200
Subject: [PATCH 1/2] EXAMINE: Correct tests of normality when there is no
 factor

Thanks to Johannes Weingartner for reporting the issue.
---
 src/language/commands/examine.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/language/commands/examine.c b/src/language/commands/examine.c
index d25dee0..b3039d7 100644
--- a/src/language/commands/examine.c
+++ b/src/language/commands/examine.c
@@ -681,7 +681,16 @@ normality_report (const struct examine *cmd, int iact_idx)
 
       for (size_t i = 0; i < n_cats; ++i)
         {
-          indexes[1] = i;
+          /* The category indexes belong to the interaction dimensions
+             (as in descriptives_report).  "indexes[1] = i" overwrote the
+             dependent-variable index when there is no factor, so all
+             variables landed in the first row. */
+          for (size_t j = 0; j < iact->n_vars; j++)
+            {
+              int idx = categoricals_get_value_index_by_category_real (
+                cmd->cats, iact_idx, i, j);
+              indexes[table->n_dimensions - 2 - j] = idx;
+            }
 
           const struct exploratory_stats *es
             = categoricals_get_user_data_by_category_real (
-- 
